{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "redirects": [
    { "source": "/admin", "destination": "/admin/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/admin/api/:path*", "destination": "/api/proxy" },
    { "source": "/admin/assets/:path*", "destination": "/admin-current/assets/:path*" },
    { "source": "/admin/", "destination": "/admin-current/index.html" },
    { "source": "/admin/:path*", "destination": "/admin-current/index.html" },
    { "source": "/:path*", "destination": "/index.html" }
  ]
}
